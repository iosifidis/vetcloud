# VetCloud Environment Variables
# Copy to .env and modify for your environment

# Database
DATABASE_URL=postgres://admin:password123@localhost:5432/pims_db?sslmode=disable

# JWT (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=change-this-in-production-please-use-a-long-random-string
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# CORS
CORS_ORIGIN=http://localhost:5173

# Multi-tenancy (set to false for cloud multi-clinic mode)
SINGLE_TENANT=true
CATALOG_DATABASE_URL=

# Environment
ENVIRONMENT=development
